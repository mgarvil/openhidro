{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenHidro",
  "version": "0.5.0",
  "identifier": "br.com.mgarvil.openhidro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenHidro",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "OpenHidro",
    "category": "Productivity",
    "shortDescription": "Projeto hidrossanitário predial",
    "longDescription": "Software livre de projeto hidrossanitário predial (NBR 5626 / NBR 8160) com integração ao Claude.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "externalBin": [
      "binaries/openhidro-motor"
    ]
  }
}
