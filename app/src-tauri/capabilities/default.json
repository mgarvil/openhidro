{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "fs:allow-remove",
    "fs:allow-write-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/openhidro-motor",
          "sidecar": true,
          "args": [
            "--entrada",
            {
              "validator": ".+"
            }
          ]
        }
      ]
    }
  ]
}
